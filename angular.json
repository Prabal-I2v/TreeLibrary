{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "newProjectRoot": "projects",
    "projects": {
        "i2v-tree": {
            "projectType": "library",
            "root": "projects/i2v-tree",
            "sourceRoot": "projects/i2v-tree/src",
            "prefix": "i2v",
            "architect": {
                "build": {
                    "builder": "@angular-devkit/build-angular:ng-packagr",
                    "options": {
                        "project": "projects/i2v-tree/ng-package.json"
                    },
                    "configurations": {
                        "production": {
                            "tsConfig": "projects/i2v-tree/tsconfig.lib.prod.json"
                        },
                        "development": {
                            "tsConfig": "projects/i2v-tree/tsconfig.lib.json"
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "test": {
                    "builder": "@angular-devkit/build-angular:karma",
                    "options": {
                        "tsConfig": "projects/i2v-tree/tsconfig.spec.json",
                        "polyfills": ["zone.js", "zone.js/testing"],
                        "karmaConfig": "projects/i2v-tree/karma.conf.js"
                    }
                },
                "lint": {
                    "builder": "@angular-eslint/builder:lint",
                    "options": {
                        "lintFilePatterns": ["projects/i2v-tree/**/*.ts", "projects/i2v-tree/**/*.html"]
                    }
                }
            }
        },
        "of-demo": {
            "projectType": "application",
            "root": "projects/of-demo",
            "sourceRoot": "projects/of-demo/src",
            "prefix": "app",
            "architect": {
                "build": {
                    "builder": "@angular-devkit/build-angular:application",
                    "options": {
                        "outputPath": "dist/of-demo",
                        "index": "projects/of-demo/src/index.html",
                        "browser": "projects/of-demo/src/main.ts",
                        "polyfills": ["zone.js"],
                        "tsConfig": "projects/of-demo/tsconfig.app.json",
                        "assets": ["projects/of-demo/src/favicon.ico", "projects/of-demo/src/assets"],
                        "styles": ["projects/of-demo/src/styles.scss"],
                        "scripts": []
                    },
                    "configurations": {
                        "production": {
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "1mb",
                                    "maximumError": "2mb"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "4kb",
                                    "maximumError": "8kb"
                                }
                            ],
                            "outputHashing": "all"
                        },
                        "development": {
                            "optimization": false,
                            "extractLicenses": false,
                            "sourceMap": true
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "serve": {
                    "builder": "@angular-devkit/build-angular:dev-server",
                    "configurations": {
                        "production": {
                            "buildTarget": "of-demo:build:production"
                        },
                        "development": {
                            "buildTarget": "of-demo:build:development"
                        }
                    },
                    "defaultConfiguration": "development"
                },
                "extract-i18n": {
                    "builder": "@angular-devkit/build-angular:extract-i18n",
                    "options": {
                        "buildTarget": "of-demo:build"
                    }
                },
                "test": {
                    "builder": "@angular-devkit/build-angular:karma",
                    "options": {
                        "polyfills": ["zone.js", "zone.js/testing"],
                        "tsConfig": "projects/of-demo/tsconfig.spec.json",
                        "karmaConfig": "projects/of-demo/karma.conf.js",
                        "styles": ["projects/of-demo/src/styles.scss"],
                        "scripts": [],
                        "assets": ["projects/of-demo/src/favicon.ico", "projects/of-demo/src/assets"]
                    }
                },
                "lint": {
                    "builder": "@angular-eslint/builder:lint",
                    "options": {
                        "lintFilePatterns": ["projects/of-demo/**/*.ts", "projects/of-demo/**/*.html"]
                    }
                }
            }
        }
    },
    "cli": {
        "schematicCollections": ["@angular-eslint/schematics"],
        "analytics": false
    }
}
